    "def A_Lehman(valeurs_prop: np.ndarray[float], vecteurs_prop: np.ndarray[float], beta: float, n_site_bain, omegas):\n",
    "    return - 1 / np.pi * np.imag(G_Lehman(valeurs_prop, vecteurs_prop, beta, n_site_bain, omegas))\n",
    "    "
