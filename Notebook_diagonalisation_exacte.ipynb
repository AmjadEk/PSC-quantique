    "import numpy as np # pour les matrices denses \n",
    "import scipy.sparse as sp # pour les matrices sparse (creuses)\n",
    "from qat.fermion.hamiltonians import make_anderson_model\n",
    "import matplotlib.pyplot as plt"
   ]
